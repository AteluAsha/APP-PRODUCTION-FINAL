# .easignore REPLACES .gitignore when present – must include all .gitignore rules
# See: https://docs.expo.dev/build-reference/easignore/

# === From .gitignore (required – otherwise these get INCLUDED and archive bloats) ===
node_modules/
.expo/
dist/
dist-export-dryrun/
web-build/
expo-env.d.ts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env
.env*.local
*.tsbuildinfo
app-example
*.apk
7-chakras-master-path/
assets/dev-gallery/snapshots/
.tmp-export-android/
.tmp-export-ios/

# Pre-compression asset backup – now under android/_backups; never ship in builds
android/_backups/

# Firebase Android: must stay in archive (app.config.js android.googleServicesFile).
# Optional: EAS env GOOGLE_SERVICES_JSON (type File) if the file is absent locally.

# Native projects – builder generates top-level iOS/Android via prebuild.
# Use leading slash so local Expo modules (e.g. modules/meditation-playback/android) stay in archive.
/ios/
/android/

# Sanctuary AAC is downloaded at runtime — never ship in the binary
assets/meditation-audio/*.aac
assets/crystal-bowl-audio/*.aac
assets/head-to-heart-audio/*.aac
assets/tuning-fork-audio/*.aac

# === Additional exclusions for smaller archive (docs, logs) ===
*.md
*.log
ios_build.log
.cursor/

# Prior Play AAB/APK outputs — not needed in build archive
build-artifacts/
