<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) Auto Backup / Device Transfer rules.

  We disable cloud backup and device-to-device transfer so that per-install state
  (trial progress, course start date, completed chakras in AsyncStorage) cannot be
  restored on reinstall or phone transfer. Entitlements (RevenueCat) and user
  identity (Firebase) are restored from their servers, not from backup.

  Pre-Android 12 behavior is controlled by android:allowBackup="false" on the
  <application> tag in AndroidManifest.xml. This file handles Android 12+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
