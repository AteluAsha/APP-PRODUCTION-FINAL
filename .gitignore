# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-export-dryrun/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Firebase Android (gitignored; still included in EAS uploads — not listed in .easignore)
google-services.json

# typescript
*.tsbuildinfo

app-example

# build artifacts
*.apk
*.aab
build-artifacts/

# Pre-compression asset backup – never commit; excluded from EAS via .easignore
android/_backups/

# backup/old code folders - exclude from all builds and git
7-chakras-master-path/

# dev gallery snapshots - temporary static visual gallery
assets/dev-gallery/snapshots/

# expo export build artifacts (regenerated; never committed or shipped)
.tmp-export-android/
.tmp-export-ios/

# Local Expo module Gradle output
modules/meditation-playback/android/build/
