{
  "name": "sevenchakras",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node scripts/ensure-worklets-stub.js",
    "start": "env -u CI expo start",
    "start:clear": "env -u CI expo start --clear",
    "start:android": "REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 env -u CI expo start --clear",
    "dev:ios": "env -u CI expo start --clear --ios",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:device": "bash scripts/run-android-real-device.sh",
    "android:run": "REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo run:android --no-bundler",
    "start:android:no-git": "bash scripts/run-metro-android-no-git.sh",
    "verify:android": "bash scripts/verify-android-dev.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "capture:screens": "EXPO_PUBLIC_CAPTURE_SCREENS=1 expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "lint:fix": "npx eslint . --fix",
    "preview-android": "eas build -p android --profile preview",
    "deploy:firestore": "npx firebase-tools deploy --only firestore:rules",
    "compress-assets": "node scripts/compress-assets.js",
    "compress-assets:dry": "node scripts/compress-assets.js --dry-run",
    "compress-images": "node scripts/compress-images.js"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@bsky.app/expo-image-crop-tool": "^0.5.0",
    "@expo/vector-icons": "~14.0.4",
    "@google/generative-ai": "^0.21.0",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^7.0.0",
    "@types/html2canvas": "^0.5.35",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-contacts": "~14.0.5",
    "expo-dev-client": "~5.0.20",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-keep-awake": "~14.0.3",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-modules-core": "~2.1.1",
    "expo-navigation-bar": "~4.0.9",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.22",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-updates": "~0.27.5",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-css-interop": "^0.1.22",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-purchases": "^8.4.0",
    "react-native-reanimated": "3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^3.4.15",
    "zustand": "^5.0.1"
  },
  "expo": {
    "install": {
      "exclude": []
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@bsky.app/expo-image-crop-tool",
          "@google/generative-ai",
          "expo-av",
          "firebase",
          "react-native-css-interop",
          "tailwind-variants"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "overrides": {
    "ajv": "^8.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.14.1",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "^12.0.11",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.6",
    "metro-minify-terser": "^0.82.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "react-dom": "18.3.1",
    "react-native-svg-transformer": "^1.5.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  },
  "private": true
}
