{
  "name": "sevenchakras",
  "main": "expo-router/entry",
  "version": "1.1.31",
  "scripts": {
    "postinstall": "node scripts/ensure-worklets-stub.js && patch-package",
    "eas-build-pre-install": "node ./scripts/eas-build-pre-install.js",
    "start": "env -u CI expo start",
    "start:dev-client": "env -u CI expo start --dev-client",
    "start:dev-client:ios": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 env -u CI expo start --dev-client",
    "start:dev-client:ios:clear": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 env -u CI expo start --dev-client --clear",
    "start:dev-client:ios:lan": "REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.29 env -u CI expo start --dev-client --clear",
    "start:dev-client:ios:tunnel": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 env -u CI expo start --dev-client --tunnel",
    "start:clear": "env -u CI expo start --clear",
    "start:android": "REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 env -u CI expo start --clear",
    "dev:ios": "env -u CI expo start --clear --ios",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:device": "bash scripts/run-android-real-device.sh",
    "android:run": "REACT_NATIVE_PACKAGER_HOSTNAME=10.0.2.2 expo run:android --no-bundler",
    "start:android:no-git": "bash scripts/run-metro-android-no-git.sh",
    "verify:android": "bash scripts/verify-android-dev.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "capture:screens": "EXPO_PUBLIC_CAPTURE_SCREENS=1 expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --watchAll=false",
    "lint": "expo lint",
    "lint:fix": "npx eslint . --fix",
    "preview-android": "eas build -p android --profile preview",
    "deploy:firestore": "npx firebase-tools deploy --only firestore:rules",
    "compress-assets": "node scripts/compress-assets.js",
    "compress-assets:dry": "node scripts/compress-assets.js --dry-run",
    "compress-images": "node scripts/compress-images.js"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@bsky.app/expo-image-crop-tool": "^0.5.0",
    "@expo/vector-icons": "^14.1.0",
    "@google/generative-ai": "^0.21.0",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/native": "^7.0.0",
    "@types/html2canvas": "^0.5.35",
    "expo": "^53.0.27",
    "expo-asset": "~11.1.7",
    "expo-audio": "~0.4.9",
    "expo-av": "~15.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image-picker": "~16.1.4",
    "expo-in-app-updates": "^0.9.0",
    "expo-keep-awake": "~14.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-navigation-bar": "~4.2.8",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-sharing": "~13.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-updates": "~0.28.18",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "meditation-playback": "file:./modules/meditation-playback",
    "nativewind": "^4.1.23",
    "patch-package": "^8.0.1",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-css-interop": "^0.1.22",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-purchases": "^8.4.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^3.4.15",
    "zustand": "^5.0.1"
  },
  "expo": {
    "install": {
      "exclude": []
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@bsky.app/expo-image-crop-tool",
          "@google/generative-ai",
          "expo-av",
          "firebase",
          "react-native-css-interop",
          "tailwind-variants"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "overrides": {
    "ajv": "^8.12.0",
    "@react-native/babel-preset": "0.79.6",
    "@react-native/babel-plugin-codegen": "0.79.6",
    "@react-native/codegen": "0.79.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.14.1",
    "@types/react": "~19.0.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~13.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.14",
    "metro-minify-terser": "^0.82.1",
    "node-addon-api": "^8.0.0",
    "node-gyp": "^10.0.0",
    "prettier": "^3.3.3",
    "react-dom": "19.0.0",
    "react-native-svg-transformer": "^1.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.8.3"
  },
  "private": true
}
