rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Social Sanctuary Collection (reflections + reactions, removedAt for self-governance)
    match /social_sanctuary/{reflectionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['userId', 'chakraDay', 'message', 'timestamp', 'isAnonymous'])
                    && request.resource.data.userId is string
                    && request.resource.data.chakraDay is int
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 500
                    && request.resource.data.timestamp is timestamp
                    && request.resource.data.isAnonymous is bool;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Sanctuary user data (hidden refs, popup count, totalLessReceived, sanctuaryBlockedAt)
    // Users write their own doc for hidden list and popup count; any auth user may update
    // another user's totalLessReceived/sanctuaryBlockedAt when reacting "less" (self-governance)
    match /sanctuary_user_data/{userId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Voice Sanctuary Collection
    match /voice_sanctuary_responses/{responseId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['userId', 'chakraDay', 'audioStoragePath', 'audioUrl', 'duration', 'fileSize', 'createdAt', 'expiresAt', 'moderationStatus'])
                    && request.resource.data.userId is string
                    && request.resource.data.chakraDay is int
                    && request.resource.data.chakraDay >= 0
                    && request.resource.data.chakraDay <= 6
                    && request.resource.data.audioStoragePath is string
                    && request.resource.data.audioUrl is string
                    && request.resource.data.duration is int
                    && request.resource.data.duration > 0
                    && request.resource.data.duration <= 300
                    && request.resource.data.fileSize is int
                    && request.resource.data.fileSize > 0
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.moderationStatus in ['pending', 'approved', 'rejected'];
      allow update: if request.resource.data.saveCount is int;
      allow delete: if false;
    }

    // Chakras Collection
    match /chakras/{chakraId} {
      allow read: if true;
      allow write: if false;
    }

    // Anua Community Cache
    match /anua_community_cache/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Anua Cache Stats
    match /anua_cache_stats/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Tribe Chat – real-time messages per tribe
    match /tribes/{tribeId}/messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.text is string
                   && request.resource.data.text.size() <= 500
                   && request.resource.data.text.size() > 0
                   && request.resource.data.senderName is string
                   && 'createdAt' in request.resource.data;
      allow update, delete: if false;
    }

    // Tribe Room Members – connected and pending friends per room
    match /tribeRooms/{roomId}/members/{memberId} {
      allow read: if true;
      allow create: if request.resource.data.displayName is string
                   && request.resource.data.status in ['connected', 'pending']
                   && request.resource.data.invitedAt is string;
      allow update: if true;
      allow delete: if false;
    }

    // Scholarship Requests – audit trail for 501(c)(3) compliance
    match /scholarship_requests/{requestId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['userId', 'reason', 'timestamp'])
                   && request.resource.data.userId is string
                   && request.resource.data.reason is string
                   && request.resource.data.reason.size() <= 500
                   && request.resource.data.timestamp is timestamp;
      allow update, delete: if false;
    }

    // Soul Signatures – claimed Soul Signatures for uniqueness
    match /soul_signatures/{signature} {
      allow read: if true;
      allow create: if request.resource.data.claimedAt is timestamp;
      allow update, delete: if false;
    }

    // Users – scholarship status persistence (isScholarshipUser, scholarshipExpiryDate)
    match /users/{userId} {
      allow read: if false;
      allow create, update: if request.resource.data.keys().hasAll(['isScholarshipUser'])
                             && request.resource.data.isScholarshipUser is bool;
      allow delete: if false;
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
