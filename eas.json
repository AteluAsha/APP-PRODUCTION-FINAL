        "buildType": "app-bundle"
      }
    },
    "production-local": {
      "extends": "production",
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=\"-Xmx6g -XX:MaxMetaspaceSize=1g -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8\" -Dorg.gradle.parallel=false -Dorg.gradle.workers.max=2 -Dorg.gradle.daemon=false",
        "JAVA_HOME": "/Applications/Android Studio.app/Contents/jbr/Contents/Home",
        "ANDROID_HOME": "/Users/erindinsmore/Library/Android/sdk",
        "ANDROID_SDK_ROOT": "/Users/erindinsmore/Library/Android/sdk",
        "ANDROID_NDK_HOME": "/Users/erindinsmore/Library/Android/sdk/ndk/27.1.12297006",
        "NPM_CONFIG_CACHE": "/Users/erindinsmore/.npm-eas-local"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6760920862"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
